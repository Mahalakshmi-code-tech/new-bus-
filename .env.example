# ==============================================================================
# SmartBus Intelligent Platform - Environment Configuration Template
# Copy this file to .env and configure your local or production credentials.
# NEVER commit the real .env file with production secrets to version control!
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Optional External API Base URL (if connecting to an external microservice / backend)
VITE_API_BASE_URL=https://api.smartbus.city/v1

# Google Gemini AI Integration Key
# Used for real-time generative passenger queries.
# If omitted or left empty, SmartBus automatically uses its built-in zero-latency
# Kinetic Telemetry Intelligence Engine without breaking functionality.
VITE_GEMINI_API_KEY=

# Firebase Client SDK Configuration (Optional - for Cloud Persistence & Auth)
# If omitted, SmartBus automatically operates with the Resilient Local Storage Engine.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=smartbus-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartbus-platform
VITE_FIREBASE_STORAGE_BUCKET=smartbus-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Performance & Telemetry Feature Flags
VITE_ENABLE_PERF_MONITORING=true
VITE_TELEMETRY_REFRESH_RATE_MS=3200
